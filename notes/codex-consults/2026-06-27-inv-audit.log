    68	/-- *Freely clean shellable*: **any** tet can serve as the head of a clean
    69	shelling.  This is the public free-sticker-ball predicate Theorem 3 exports. -/
    70	def FreelyCleanShellable (τ B : Finset (Finset V)) : Prop :=
    71	  ∀ t ∈ τ, ∃ l : List (Finset V),
    72	    l.head? = some t ∧ l.toFinset = τ ∧ l.Nodup ∧ IsCleanShelling l B
    73	
    74	/-! ## Stickerball predicates (the combinatorial B³ certificate) -/
    75	
    76	/-- A **stickerball**: a shellable clean 3-complex with nonempty boundary.  Concretely `IsCleanBall`
    77	(a clean shelling exists — building *up* by sticking tetrahedra on, the reverse of shucking down,
    78	each tetrahedron after the first glued on along **one or two boundary triangles** via `CleanGlueStep`,
    79	whose `weak` field is a `GlueStep` sharing a 1- or 2-triangle face with the running boundary) with
    80	a nonempty boundary `B`.  Being an `IsCleanBall` it is in particular an `IsClean3Complex`
    81	(pure, every triangle in ≤ 2 tets, connected vertex *and* edge links) — see `IsStickerball.isClean3Complex`.
    82	
    83	By the standard PL theorem that a shellable normal 3-pseudomanifold with nonempty boundary is a PL
    84	ball, this is the combinatorial certificate for a triangulation of `B³`.  This project proves the
    85	combinatorial certificate; it does **not** formalize that external PL-homeomorphism theorem (see
    86	`notes/future-projects.md`). -/
    87	def IsStickerball (τ B : Finset (Finset V)) : Prop :=
    88	  IsCleanBall τ B ∧ B.Nonempty
    89	
    90	/-- An **anyrooted stickerball** is a stickerball whose shelling may start with any prescribed
    91	tetrahedron (`FreelyCleanShellable`).  "Stickerball" by itself is *not* anyrooted — that is the
    92	strengthened property. -/
    93	def IsAnyrootedStickerball (τ B : Finset (Finset V)) : Prop :=
    94	  IsStickerball τ B ∧ FreelyCleanShellable τ B
    95	
    96	lemma IsAnyrootedStickerball.toStickerball {τ B : Finset (Finset V)}
    97	    (h : IsAnyrootedStickerball τ B) : IsStickerball τ B := h.1
    98	
    99	lemma IsAnyrootedStickerball.freelyCleanShellable {τ B : Finset (Finset V)}
   100	    (h : IsAnyrootedStickerball τ B) : FreelyCleanShellable τ B := h.2
   101	
   102	/-- A **rooted stickerball** at `t`: a stickerball (`IsStickerball`) that, in addition, admits a
   103	*monotone* clean shelling whose first tetrahedron is `t` — every later tetrahedron is glued on along
   104	one or two boundary triangles (`CleanGlueStep`).  This is the per-root slice of `FreelyCleanShellable`
   105	(the round-3 writeup audit noted "rooted at `t`" was not yet a standalone predicate; this names it). -/
   106	def IsRootedStickerball (τ B : Finset (Finset V)) (t : Finset V) : Prop :=
   107	  IsStickerball τ B ∧
   108	    ∃ l : List (Finset V), l.head? = some t ∧ l.toFinset = τ ∧ l.Nodup ∧ IsCleanShelling l B
   109	
   110	lemma IsRootedStickerball.toStickerball {τ B : Finset (Finset V)} {t : Finset V}
   111	    (h : IsRootedStickerball τ B t) : IsStickerball τ B := h.1
   112	

